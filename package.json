{
  "name": "nz-legislation-mcp",
  "version": "0.0.0",
  "description": "Unofficial, security-hardened MCP server for the New Zealand Legislation API. Bring your own API key.",
  "license": "Apache-2.0",
  "author": "nz-legislation-mcp contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatskiff33-agents/nz-legislation-mcp.git"
  },
  "bugs": "https://github.com/thatskiff33-agents/nz-legislation-mcp/issues",
  "homepage": "https://github.com/thatskiff33-agents/nz-legislation-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "new-zealand",
    "legislation",
    "law"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.1",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run knip && pnpm run test && pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "knip": "^6.42.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
