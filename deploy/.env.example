# Copy to .env and fill in. Your API key goes in secrets/legislation_api_key, not here.

# Your domain (DNS must point at this server). The endpoint will be https://<domain>/mcp.
NZLM_DOMAIN=mcp.example.com

# Your identity provider (see docs/self-hosting.md for Auth0 and Keycloak recipes).
LEGISLATION_NZ_OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
LEGISLATION_NZ_OAUTH_ALLOWED_SUBJECTS=auth0|YOUR-USER-ID

# A published image, pinned by digest after verifying its signature (docs/self-hosting.md).
# Without it, use the build override (docker-compose.build.yml) to build from source.
# NZLM_IMAGE=ghcr.io/thatskiff33/nz-legislation-mcp:1.0.1@sha256:<digest>
# LEGISLATION_NZ_OAUTH_REQUIRED_SCOPES=
# LEGISLATION_NZ_RATE_LIMIT_PER_MINUTE=60
# LEGISLATION_NZ_LOG_LEVEL=info
